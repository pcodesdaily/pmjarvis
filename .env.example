# ============================================================================
#  PMJARVIS — copy this file to .env and fill it in.
#  Everything below with a value already set is a sensible default.
# ============================================================================

# --- Required ---------------------------------------------------------------
# Discord Developer Portal -> your app -> Bot -> Reset Token
DISCORD_TOKEN=
# Discord Developer Portal -> your app -> General Information -> Application ID
CLIENT_ID=

# --- Command registration ---------------------------------------------------
# Set to a server ID while developing: slash commands appear instantly there.
# Leave empty in production to register globally (first sync takes up to 1h).
DEV_GUILD_ID=
AUTO_DEPLOY_COMMANDS=true

# --- Text commands ----------------------------------------------------------
# Text commands need the MESSAGE CONTENT intent enabled in the Developer Portal
# (Bot -> Privileged Gateway Intents). Set to false to run slash-only.
ENABLE_MESSAGE_COMMANDS=true
PREFIX=pm!
# Comma-separated user IDs that bypass DJ restrictions.
OWNER_IDS=

# --- Behaviour --------------------------------------------------------------
LOG_LEVEL=info
ACTIVITY=music in {guilds} servers
COLOR_PRIMARY=5865F2
TZ=UTC

DEFAULT_VOLUME=100
MAX_VOLUME=150
# Lavalink plays slightly below the displayed volume so loud masters and boosted
# EQ presets have headroom instead of clipping. 0.85 is a good balance.
VOLUME_DECREMENTER=0.85
# ytmsearch (YouTube Music) gives the best matches for song titles.
DEFAULT_SEARCH_PLATFORM=ytmsearch

# Milliseconds before leaving after the queue empties (0 = never leave).
LEAVE_ON_END_MS=120000
# Milliseconds before leaving an empty voice channel (0 = never leave).
LEAVE_ON_EMPTY_MS=60000
MAX_QUEUE_SIZE=5000
MAX_PLAYLIST_SIZE=1000

# When true anyone can skip/stop. Set false to require the DJ role or Manage
# Server for destructive commands once more than one person is listening.
DJ_FREE_FOR_ALL=true
DJ_ROLE_NAME=DJ

# --- Lavalink ---------------------------------------------------------------
# Change this before deploying. The bot and Lavalink must agree on it.
LAVALINK_PASSWORD=change-this-password
# Java heap for the audio server. 400m comfortably handles a few dozen guilds;
# raise it if you run many simultaneous players.
LAVALINK_XMX=400m
# Hard container memory ceilings, so neither service can take the VPS down.
LAVALINK_MEM_LIMIT=700m
BOT_MEM_LIMIT=256m
# Only needed when pointing at an external Lavalink instead of the bundled one.
# LAVALINK_HOST=lavalink
# LAVALINK_PORT=2333
# LAVALINK_SECURE=false

# --- Optional YouTube hardening ---------------------------------------------
# Only needed if YouTube starts rate-limiting your VPS IP. See
# https://github.com/lavalink-devs/youtube-source for how to obtain these.
YOUTUBE_OAUTH_ENABLED=false
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_OAUTH_SKIP_INIT=false
YOUTUBE_PO_TOKEN=
YOUTUBE_VISITOR_DATA=
